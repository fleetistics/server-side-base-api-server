{
  "Team": {
    "JoinBasedUrl": "pssp://joinCode/"
  },
  "Media": {
    "UploadFolder": "e:\\work\\web_uploads\\base-server-side\\",
    "BaseUrl": "http://192.168.100.180:7225/media/"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://192.168.100.180:7225"
      }
    }
  },
  "DataProtectionPersistKeysPath": "e:\\work\\logs\\base-server-side\\dataProtectionKeys",
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "c:\\work\\logs\\base-server-side\\serilog-all-.log",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Debug",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{ThreadId}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "c:\\work\\logs\\base-server-side\\serilog-own-.log",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Information",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{ThreadId}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        },
        "Filter": [
          {
            "Name": "ByExcluding",
            "Args": {
              "expression": "SourceContext like 'Microsoft.EntityFrameworkCore%'"
            }
          }
        ]
      },
      {
        "Name": "OpenTelemetry",
        "Args": {
          "endpoint": "http://localhost:4317",
          "protocol": "Grpc",
          "restrictedToMinimumLevel": "Information",
          "resourceAttributes": { "service.name": "base-server-side" }
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithEnvironmentUserName", "WithMachineName", "WithThreadId" ]
  },
  "ConnectionStrings": {
